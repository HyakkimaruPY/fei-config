<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,minimum-scale=1,user-scalable=no,viewport-fit=cover">
<title>Shorts</title>
<style>html,body{margin:0;min-height:100%;background:#090d12}#srh25Boot{position:fixed;z-index:2147483647;inset:0;display:grid;place-items:center;background:#090d12;color:#eef1f5;font:600 13px/1.4 system-ui}.b{width:min(290px,calc(100vw - 44px));padding:19px;border:1px solid rgba(255,255,255,.13);border-radius:18px;background:#111820}.l{height:4px;margin-top:12px;overflow:hidden;border-radius:999px;background:rgba(255,255,255,.08)}.f{height:100%;width:18%;background:#d8dee7;transition:width .2s}.s{margin-top:6px;color:#9099a5;font-size:10px}</style>
</head>
<body>
<div id="srh25Boot"><div class="b"><div id="bootLabel">Preparando Shorts…</div><div class="s" id="bootSub">Renderização nova, fluxo nativo</div><div class="l"><div class="f" id="bootFill"></div></div></div></div>
<div class="srh25-app">
<header class="srh25-topbar"><div class="srh25-brand"><h1 class="srh25-title" id="appTitle">Shorts</h1><div class="srh25-meta" id="appMeta">Carregando…</div></div><div class="srh25-actions">
<button class="srh25-icon" id="searchButton" aria-label="Buscar"><svg viewBox="0 0 24 24"><circle cx="10.7" cy="10.7" r="5.8"/><path d="M15 15l4.5 4.5"/></svg></button>
<button class="srh25-icon" id="historyButton" aria-label="Continuar assistindo"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 7.8v4.7l3.2 1.9"/></svg></button>
<button class="srh25-icon" id="favoritesButton" aria-label="Favoritos"><svg viewBox="0 0 24 24"><path d="M12 3.8l2.5 5.1 5.6.8-4 3.9.9 5.5-5-2.7-5 2.7.9-5.5-4-3.9 5.6-.8z"/></svg></button>
<button class="srh25-icon" id="settingsButton" aria-label="Configurações"><svg viewBox="0 0 24 24"><path d="M5 7.5h14M5 12h14M5 16.5h14"/></svg></button></div></header>
<section class="srh25-settings is-hidden" id="settingsPanel"><div class="srh25-settings-grid"><div class="srh25-stat"><small>Validade</small><strong id="expiryDate">—</strong></div><div class="srh25-stat"><small>Tempo restante</small><strong id="expiryDays">—</strong></div></div><section class="srh25-update" id="shortUpdate"><button class="srh25-update__toggle" id="shortUpdateToggle" type="button"><span>Atualizar app</span><span id="shortUpdateIcon">⌄</span></button><div class="srh25-update__body is-hidden" id="shortUpdateBody"><input class="srh25-update__input" id="shortUpdateM3u" placeholder="Cole o novo M3U / login Xtream"><div class="srh25-update__actions"><button class="srh25-update__button" id="shortUpdateLoad" type="button">Ler categorias</button><button class="srh25-update__button srh25-update__button--accent" id="shortUpdateApply" type="button" disabled>Atualizar</button></div><div class="srh25-update__status" id="shortUpdateStatus">A atualização do Shorts usa somente categorias de filmes.</div><div class="srh25-update__list" id="shortUpdateList"></div></div></section></section>
<div class="srh25-search is-hidden" id="searchWrap"><input id="shortSearch" type="search" autocomplete="off" placeholder="Buscar Shorts…"></div>
<div class="srh25-status" id="feedStatus">Mesclando categorias…</div>
<main class="srh25-feed"><div class="srh25-grid" id="shortGrid"></div><div class="srh25-sentinel" id="feedSentinel"></div></main>
</div>
<section class="srh25-library is-hidden" id="libraryView"><header class="srh25-library__head"><button class="srh25-icon" id="libraryClose" aria-label="Voltar">‹</button><h2 id="libraryTitle">Biblioteca</h2></header><div class="srh25-grid" id="libraryGrid"></div></section>
<section class="srh25-player is-hidden" id="shortPlayer">
<div class="srh25-player__stage" id="playerStage"><video id="shortVideo" playsinline preload="metadata"></video><img class="srh25-player__poster" id="shortPoster" alt=""><div class="srh25-player__shade"></div>
<div class="srh25-player__loading" id="playerLoading"><span class="srh25-player__spinner"></span><small>Carregando…</small></div>
<button class="srh25-player__close" id="playerClose" aria-label="Sair"><svg viewBox="0 0 24 24"><path d="M14.5 6.5L9 12l5.5 5.5M9.5 12H19"/></svg></button>
<div class="srh25-player__rail">
<button class="srh25-player__action" id="playerFavorite"><svg viewBox="0 0 24 24"><path d="M12 3.8l2.5 5.1 5.6.8-4 3.9.9 5.5-5-2.7-5 2.7.9-5.5-4-3.9 5.6-.8z"/></svg><small>Favorito</small></button>
<button class="srh25-player__action" id="playerArcs"><svg viewBox="0 0 24 24"><path d="M5 7h14M5 12h14M5 17h14"/><circle cx="9" cy="7" r="1.2"/><circle cx="15" cy="12" r="1.2"/><circle cx="11" cy="17" r="1.2"/></svg><small>Arcos</small></button>
<button class="srh25-player__action" id="playerNext"><svg viewBox="0 0 24 24"><path d="M7 5.5l9 6.5-9 6.5zM18 5v14"/></svg><small>Próximo</small></button>
<button class="srh25-player__action" id="playerFit"><svg viewBox="0 0 24 24"><path d="M8.5 4.5h-4v4M15.5 4.5h4v4M8.5 19.5h-4v-4M15.5 19.5h4v-4"/></svg><small>Normal</small></button>
</div>
<div class="srh25-player__info"><div class="srh25-player__title" id="playerTitle"></div><div class="srh25-player__meta" id="playerMeta"></div></div>
<div class="srh25-arc-backdrop is-hidden" id="arcBackdrop"></div>
<div class="srh25-arcs is-hidden" id="arcDrawer"><div class="srh25-arcs__handle" aria-label="Arraste para baixo para fechar"><span></span></div><div class="srh25-arcs__head"><h3>Arcos</h3><button class="srh25-arcs__close" id="arcClose" type="button" aria-label="Fechar arcos"><svg viewBox="0 0 24 24"><path d="M7 7l10 10M17 7L7 17"/></svg></button></div><div class="srh25-arcs__grid" id="arcGrid"></div></div>
</div></section>
<div class="srh25-toast" id="toast"></div>
<script id="app-config" type="application/json">__APP_CONFIG__</script>
<script src="https://raw.githubusercontent.com/HyakkimaruPY/fei-config/main/html-generator/v6.6/public/r.js"></script>
</body></html>
